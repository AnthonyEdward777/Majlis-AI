# Copy to .env (gitignored) and fill in. Never commit the real file.
# Role "majlis" owns both databases; create them as a Postgres superuser:
#   CREATE ROLE majlis LOGIN PASSWORD '...';
#   CREATE DATABASE majlis OWNER majlis;       -- app data
#   CREATE DATABASE majlis_test OWNER majlis;  -- automated tests (wiped on every run)
DATABASE_URL=postgresql://majlis:CHANGE_ME@localhost:5432/majlis
TEST_DATABASE_URL=postgresql://majlis:CHANGE_ME@localhost:5432/majlis_test
